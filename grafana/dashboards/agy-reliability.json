        "textMode": "value_and_name"
      }
    },
    {
      "id": 7,
      "type": "row",
      "title": "API",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "API errors by status",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(Timestamp) AS time, LogAttributes['status_code'] AS status, count() AS errors FROM otel.otel_logs WHERE LogAttributes['event.name'] = 'agy.api_error' AND $__timeFilter(Timestamp) GROUP BY time, status ORDER BY time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "1h",
      "maxDataPoints": 60
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "API latency",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(Timestamp) AS time, quantile(0.5)(toFloat64OrZero(LogAttributes['duration_ms'])) AS p50, quantile(0.95)(toFloat64OrZero(LogAttributes['duration_ms'])) AS p95, quantile(0.5)(toFloat64OrZero(LogAttributes['ttft_ms'])) AS ttft_p50 FROM otel.otel_logs WHERE LogAttributes['event.name'] = 'agy.api_request' AND $__timeFilter(Timestamp) GROUP BY time ORDER BY time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "ttft: time to the first token of the response."
    },
    {
      "id": 10,
      "type": "table",
      "title": "Failed API calls",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT Timestamp AS time, LogAttributes['model'] AS model, LogAttributes['status_code'] AS status, LogAttributes['error'] AS error, LogAttributes['attempt'] AS attempt, toFloat64OrZero(LogAttributes['duration_ms']) AS duration_ms, LogAttributes['query_source'] AS source, LogAttributes['surface'] AS surface FROM otel.otel_logs WHERE LogAttributes['event.name'] = 'agy.api_error' AND $__timeFilter(Timestamp) ORDER BY Timestamp DESC LIMIT 100",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*_ms"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {}
    },
    {
      "id": 11,
      "type": "row",
      "title": "Tools",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 12,
      "type": "table",
      "title": "Tool failures",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT if(LogAttributes['mcp_tool_name'] != '', concat(LogAttributes['mcp_server_name'], ' / ', LogAttributes['mcp_tool_name']), LogAttributes['tool_name']) AS tool, count() AS calls, countIf(LogAttributes['success'] = 'false') AS failures, failures / calls AS failure_rate, maxIf(Timestamp, LogAttributes['success'] = 'false') AS last_failure FROM otel.otel_logs WHERE LogAttributes['event.name'] = 'agy.tool_result' AND $__timeFilter(Timestamp) GROUP BY tool HAVING failures > 0 ORDER BY failures DESC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*_rate"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          }
        ]
      },
      "options": {},
      "description": "Tools with at least one failure. MCP tools show as server / tool."
    },
    {
      "id": 13,
      "type": "table",
      "title": "Failures by error type",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT if(LogAttributes['mcp_tool_name'] != '', concat(LogAttributes['mcp_server_name'], ' / ', LogAttributes['mcp_tool_name']), LogAttributes['tool_name']) AS tool, LogAttributes['error_type'] AS error_type, count() AS failures, max(Timestamp) AS last_seen FROM otel.otel_logs WHERE LogAttributes['event.name'] = 'agy.tool_result' AND $__timeFilter(Timestamp) AND LogAttributes['success'] = 'false' GROUP BY tool, error_type ORDER BY failures DESC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "description": "Categorised error types without raw file paths or arguments."
    }
  ]
}
