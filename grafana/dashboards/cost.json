                "value": "short"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "after"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              }
            ]
          }
        ]
      },
      "options": {},
      "description": "trigger is manual for /compact and auto when the context window filled up."
    },
    {
      "id": 15,
      "type": "table",
      "title": "Session context",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "WITH LogAttributes['event.name'] AS ev, ev = 'api_request' AND (startsWith(LogAttributes['query_source'], 'repl_main_thread') OR LogAttributes['query_source'] = 'sdk') AS main, (toUInt64OrZero(LogAttributes['input_tokens']) + toUInt64OrZero(LogAttributes['cache_read_tokens']) + toUInt64OrZero(LogAttributes['cache_creation_tokens'])) AS ctx SELECT LogAttributes['session.id'] AS session, anyIf(LogAttributes['vcs.repository.name'], LogAttributes['vcs.repository.name'] != '') AS repository, topKIf(1)(LogAttributes['model'], main)[1] AS model, countIf(ev = 'user_prompt') AS prompts, countIf(main) AS main_requests, argMinIf(ctx, Timestamp, main) AS first_context, avgIf(ctx, main) AS avg_context, maxIf(ctx, main) AS max_context, countIf(ev = 'compaction') AS compactions, sumIf(toFloat64OrZero(LogAttributes['cost_usd']), ev = 'api_request') AS cost_usd, cost_usd / nullIf(prompts, 0) AS cost_per_prompt FROM otel.otel_logs WHERE ev IN ('api_request', 'user_prompt', 'compaction') AND $__timeFilter(Timestamp) GROUP BY session HAVING main_requests > 0 ORDER BY cost_usd DESC LIMIT 20",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "first_context"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "avg_context"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "max_context"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "cost_usd"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "cost_per_prompt"
            },
            "properties": [
              {
                "id": "unit",
