<clickhouse>
    <users>
        <grafana>
            <password from_env="GRAFANA_CLICKHOUSE_PASSWORD"/>
            <networks>
                <ip>::/0</ip>
            </networks>
            <profile>default</profile>
            <quota>default</quota>
            <grants>
                <query>GRANT SELECT ON otel.*</query>
                <query>GRANT SELECT ON system.parts</query>
                <query>GRANT SELECT ON system.disks</query>
                <query>GRANT SHOW TABLES ON system.*</query>
            </grants>
        </grafana>
    </users>
</clickhouse>
