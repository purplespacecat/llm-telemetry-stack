      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Skill activations",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(Timestamp) AS time, LogAttributes['skill.name'] AS skill, count() AS activations FROM otel.otel_logs WHERE LogAttributes['event.name'] = 'skill_activated' AND $__timeFilter(Timestamp) GROUP BY time, skill ORDER BY time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Skills you write yourself show as custom_skill unless OTEL_LOG_TOOL_DETAILS=1.",
      "interval": "1h",
      "maxDataPoints": 60
    },
    {
      "id": 12,
      "type": "table",
      "title": "Skills",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 14,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT LogAttributes['skill.name'] AS skill, any(LogAttributes['skill.source']) AS source, count() AS activations, countIf(LogAttributes['invocation_trigger'] = 'user-slash') AS by_you, countIf(LogAttributes['invocation_trigger'] = 'claude-proactive') AS by_claude, countIf(LogAttributes['invocation_trigger'] = 'nested-skill') AS nested, max(Timestamp) AS last_used FROM otel.otel_logs WHERE LogAttributes['event.name'] = 'skill_activated' AND $__timeFilter(Timestamp) GROUP BY skill ORDER BY activations DESC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "description": "by_you: you typed the / command. by_claude: Claude picked the skill itself. A skill you often type but Claude never picks may need a clearer description."
    },
    {
      "id": 13,
      "type": "table",
      "title": "Sessions without skills",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 14,
        "y": 22,
        "w": 10,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "WITH skilled AS (SELECT DISTINCT LogAttributes['session.id'] FROM otel.otel_logs WHERE LogAttributes['event.name'] = 'skill_activated' AND $__timeFilter(Timestamp)) SELECT if(repository = '', '(not recorded)', repository) AS repository, count() AS sessions, countIf(session NOT IN skilled) AS without_skills, sumIf(cost_usd, session NOT IN skilled) AS cost_without_skills FROM (SELECT Attributes['session.id'] AS session, any(Attributes['vcs.repository.name']) AS repository, sum(Value) AS cost_usd FROM otel.otel_metrics_sum WHERE MetricName = 'claude_code.cost.usage' AND $__timeFilter(TimeUnix) GROUP BY session) GROUP BY repository ORDER BY without_skills DESC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "cost_without_skills"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          }
        ]
      },
      "options": {},
      "description": "Sessions where no skill ran, by repository: places to look for skills you could have used."
    },
    {
      "id": 14,
      "type": "row",
      "title": "Tools and permissions",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 15,
      "type": "table",
      "title": "Tools",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT if(LogAttributes['mcp_tool_name'] != '', concat(LogAttributes['mcp_server_name'], ' / ', LogAttributes['mcp_tool_name']), LogAttributes['tool_name']) AS tool, count() AS calls, quantile(0.5)(toFloat64OrZero(LogAttributes['duration_ms'])) AS p50_ms, quantile(0.95)(toFloat64OrZero(LogAttributes['duration_ms'])) AS p95_ms, sum(toFloat64OrZero(LogAttributes['duration_ms'])) / 1000 AS total_time FROM otel.otel_logs WHERE LogAttributes['event.name'] = 'tool_result' AND $__timeFilter(Timestamp) GROUP BY tool ORDER BY calls DESC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*_ms"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "total_time"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "options": {},
      "description": "MCP tools show as server / tool. Their names need OTEL_LOG_TOOL_DETAILS=1."
    },
    {
      "id": 16,
      "type": "table",
      "title": "Permission decisions",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT LogAttributes['tool_name'] AS tool, LogAttributes['source'] AS source, countIf(LogAttributes['decision'] = 'accept') AS accepted, countIf(LogAttributes['decision'] = 'reject') AS rejected FROM otel.otel_logs WHERE LogAttributes['event.name'] = 'tool_decision' AND $__timeFilter(Timestamp) GROUP BY tool, source ORDER BY accepted + rejected DESC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "description": "source config: an allow or deny rule decided. user_*: you were asked."
    },
    {
      "id": 17,
      "type": "row",
      "title": "MCP servers and hooks",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 41,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 18,
      "type": "table",
      "title": "MCP servers",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 42,
        "w": 9,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT if(LogAttributes['mcp_server_name'] = '', '(not recorded)', LogAttributes['mcp_server_name']) AS server, count() AS calls, uniqExact(LogAttributes['mcp_tool_name']) AS tools, quantile(0.95)(toFloat64OrZero(LogAttributes['duration_ms'])) AS p95_ms, max(Timestamp) AS last_used FROM otel.otel_logs WHERE LogAttributes['event.name'] = 'tool_result' AND $__timeFilter(Timestamp) AND LogAttributes['tool_name'] = 'mcp_tool' GROUP BY server ORDER BY calls DESC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*_ms"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {},
      "description": "Server names need OTEL_LOG_TOOL_DETAILS=1. The Tools table breaks calls down by tool."
    },
    {
      "id": 19,
      "type": "table",
      "title": "Hooks",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 9,
        "y": 42,
        "w": 15,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT LogAttributes['hook_name'] AS hook, count() AS runs, sum(toUInt32OrZero(LogAttributes['num_blocking'])) AS blocked, quantile(0.5)(toFloat64OrZero(LogAttributes['total_duration_ms'])) AS p50_ms, quantile(0.95)(toFloat64OrZero(LogAttributes['total_duration_ms'])) AS p95_ms, sum(toFloat64OrZero(LogAttributes['total_duration_ms'])) / 1000 AS total_time FROM otel.otel_logs WHERE LogAttributes['event.name'] = 'hook_execution_complete' AND $__timeFilter(Timestamp) GROUP BY hook ORDER BY total_time DESC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*_ms"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "total_time"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "options": {},
      "description": "One row per hook event and matcher. Claude Code doesn't report which hook command ran. blocked: a hook stopped the action."
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Hook time",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
