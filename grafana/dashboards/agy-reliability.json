          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT countIf(LogAttributes['success'] = 'false') AS failures FROM otel.otel_logs WHERE LogAttributes['event.name'] = 'agy.tool_result' AND $__timeFilter(Timestamp)",
          "refId": "A"
