          "queryType": "table",
          "rawSql": "SELECT sum(Value) / nullIf(uniqExact(Attributes['session.id']), 0) AS per_session FROM otel.otel_metrics_sum WHERE MetricName = 'claude_code.cost.usage' AND $__timeFilter(TimeUnix)",
          "refId": "A"
