          "rawSql": "SELECT Attributes['model'] AS model, sumIf(Value, MetricName = 'claude_code.token.usage' AND Attributes['type'] = 'input') AS input, sumIf(Value, MetricName = 'claude_code.token.usage' AND Attributes['type'] = 'cacheRead') AS cache_read, sumIf(Value, MetricName = 'claude_code.token.usage' AND Attributes['type'] = 'cacheCreation') AS cache_write, sumIf(Value, MetricName = 'claude_code.token.usage' AND Attributes['type'] = 'output') AS output, sumIf(Value, MetricName = 'claude_code.cost.usage') AS cost_usd FROM otel.otel_metrics_sum WHERE MetricName IN ('claude_code.token.usage', 'claude_code.cost.usage') AND $__timeFilter(TimeUnix) GROUP BY model ORDER BY cost_usd DESC",
