      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Tool failure rate",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT countIf(LogAttributes['success'] = 'false') / nullIf(count(), 0) AS failure_rate FROM otel.otel_logs WHERE LogAttributes['event.name'] = 'agy.tool_result' AND $__timeFilter(Timestamp)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
