    {
      "id": 13,
      "type": "timeseries",
      "title": "Context size (main thread)",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 16,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(Timestamp) AS time, substring(LogAttributes['session.id'], 1, 8) AS session, max((toUInt64OrZero(LogAttributes['input_tokens']) + toUInt64OrZero(LogAttributes['cache_read_tokens']) + toUInt64OrZero(LogAttributes['cache_creation_tokens']))) AS context FROM otel.otel_logs WHERE LogAttributes['event.name'] = 'api_request' AND (startsWith(LogAttributes['query_source'], 'repl_main_thread') OR LogAttributes['query_source'] = 'sdk') AND $__timeFilter(Timestamp) GROUP BY time, session ORDER BY time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "always",
            "pointSize": 4,
            "spanNulls": false
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "5m",
      "maxDataPoints": 300,
      "description": "Tokens sent with each request of your conversation (input + cache read + cache write), largest per interval, one line per session. Every request re-sends the whole conversation, so cost per request grows with it. /compact or /clear brings it down; resuming an old session brings it back."
    },
    {
      "id": 14,
      "type": "table",
      "title": "Compactions",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 16,
        "y": 23,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT Timestamp AS time, substring(LogAttributes['session.id'], 1, 8) AS session, LogAttributes['trigger'] AS trigger, toUInt64OrZero(LogAttributes['pre_tokens']) AS before, toUInt64OrZero(LogAttributes['post_tokens']) AS after, toUInt64OrZero(LogAttributes['duration_ms']) AS duration FROM otel.otel_logs WHERE LogAttributes['event.name'] = 'compaction' AND $__timeFilter(Timestamp) ORDER BY time DESC LIMIT 50",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
