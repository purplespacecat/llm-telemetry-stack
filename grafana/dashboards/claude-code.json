          "queryType": "table",
          "rawSql": "SELECT sumIf(Value, Attributes['type'] = 'added') AS added, sumIf(Value, Attributes['type'] = 'removed') AS removed FROM otel.otel_metrics_sum WHERE MetricName = 'claude_code.lines_of_code.count' AND $__timeFilter(TimeUnix)",
