            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT countIf(LogAttributes['success'] = 'false') AS failures FROM otel.otel_logs WHERE LogAttributes['event.name'] = 'agy.subagent_invoked' AND $__timeFilter(Timestamp)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
