    {
      "id": 5,
      "type": "stat",
      "title": "Cache hit ratio",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
