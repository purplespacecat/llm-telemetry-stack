      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT count() AS prompts FROM otel.otel_logs WHERE LogAttributes['event.name'] = 'tool_decision' AND $__timeFilter(Timestamp) AND startsWith(LogAttributes['source'], 'user')",
