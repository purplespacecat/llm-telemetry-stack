    {
      "id": 9,
      "type": "table",
      "title": "Cost by repository",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 6,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT if(Attributes['vcs.repository.name'] = '', '(not recorded)', Attributes['vcs.repository.name']) AS repository, sum(Value) AS cost_usd, uniqExact(Attributes['session.id']) AS sessions FROM otel.otel_metrics_sum WHERE MetricName = 'claude_code.cost.usage' AND $__timeFilter(TimeUnix) GROUP BY repository ORDER BY cost_usd DESC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "cost_usd"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          }
        ]
      },
      "options": {},
      "description": "Needs OTEL_METRICS_INCLUDE_REPOSITORY=true. Sessions started outside a git repository show as (not recorded)."
    },
    {
      "id": 10,
      "type": "table",
      "title": "Cost by source",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 6,
        "y": 13,
        "w": 10,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT LogAttributes['query_source'] AS source, LogAttributes['agent.name'] AS agent, LogAttributes['model'] AS model, LogAttributes['skill.name'] AS skill, LogAttributes['mcp_server.name'] AS mcp_server, count() AS requests, sum(toFloat64OrZero(LogAttributes['cost_usd'])) AS cost_usd FROM otel.otel_logs WHERE LogAttributes['event.name'] = 'api_request' AND $__timeFilter(Timestamp) GROUP BY source, agent, model, skill, mcp_server ORDER BY cost_usd DESC LIMIT 50",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "cost_usd"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          }
        ]
      },
      "options": {},
      "description": "repl_main_thread is your conversation and agent:* are subagents. agent_summary, away_summary, prompt_suggestion and compact are requests Claude Code makes in the background, on the session's model. Custom agent and skill names are replaced by placeholders unless OTEL_LOG_TOOL_DETAILS=1."
    },
    {
      "id": 11,
      "type": "table",
      "title": "Top sessions",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 16,
        "y": 13,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT Attributes['session.id'] AS session, any(Attributes['vcs.repository.name']) AS repository, min(TimeUnix) AS started, max(TimeUnix) AS last_seen, sumIf(Value, MetricName = 'claude_code.cost.usage') AS cost_usd, sumIf(Value, MetricName = 'claude_code.token.usage') AS tokens FROM otel.otel_metrics_sum WHERE MetricName IN ('claude_code.cost.usage', 'claude_code.token.usage') AND $__timeFilter(TimeUnix) GROUP BY session ORDER BY cost_usd DESC LIMIT 20",
          "refId": "A"
        }
