            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT sumIf(Value, Attributes['type'] = 'cacheRead') / nullIf(sum(Value), 0) AS ratio FROM otel.otel_metrics_sum WHERE MetricName = 'claude_code.token.usage' AND $__timeFilter(TimeUnix) AND Attributes['type'] != 'output'",
