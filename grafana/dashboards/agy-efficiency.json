    {
      "id": 8,
      "type": "timeseries",
      "title": "Commits and pull requests",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(TimeUnix) AS time, replaceOne(MetricName, 'agy.', '') AS metric, sum(Value) AS count FROM otel.otel_metrics_sum WHERE MetricName IN ('agy.commit.count', 'agy.pull_request.count') AND $__timeFilter(TimeUnix) GROUP BY time, metric ORDER BY time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "1h",
      "maxDataPoints": 60
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Active time",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(TimeUnix) AS time, Attributes['type'] AS type, sum(Value) AS seconds FROM otel.otel_metrics_sum WHERE MetricName = 'agy.active_time.total' AND $__timeFilter(TimeUnix) GROUP BY time, type ORDER BY time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "user: permission and interaction time. cli: Antigravity generating responses and running tools.",
      "interval": "1h",
      "maxDataPoints": 60
    },
    {
      "id": 10,
      "type": "row",
      "title": "Skills",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Skill activations",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(Timestamp) AS time, LogAttributes['skill.name'] AS skill, count() AS activations FROM otel.otel_logs WHERE LogAttributes['event.name'] = 'agy.skill_activated' AND $__timeFilter(Timestamp) GROUP BY time, skill ORDER BY time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Recorded when Antigravity reads a skill's SKILL.md.",
      "interval": "1h",
      "maxDataPoints": 60
    },
    {
      "id": 12,
      "type": "table",
      "title": "Skills",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 14,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT LogAttributes['skill.name'] AS skill, any(LogAttributes['skill.source']) AS source, count() AS activations, countIf(LogAttributes['invocation_trigger'] = 'user-slash') AS by_you, countIf(LogAttributes['invocation_trigger'] = 'agy-proactive') AS by_agy, max(Timestamp) AS last_used FROM otel.otel_logs WHERE LogAttributes['event.name'] = 'agy.skill_activated' AND $__timeFilter(Timestamp) GROUP BY skill ORDER BY activations DESC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "description": "source: builtin, plugin, user or workspace. by_agy: Antigravity activated the skill via progressive disclosure."
    },
    {
      "id": 13,
      "type": "table",
      "title": "Sessions without skills",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 14,
        "y": 22,
        "w": 10,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "WITH skilled AS (SELECT DISTINCT LogAttributes['session.id'] FROM otel.otel_logs WHERE LogAttributes['event.name'] = 'agy.skill_activated' AND $__timeFilter(Timestamp)) SELECT if(repository = '', '(not recorded)', repository) AS repository, count() AS sessions, countIf(session NOT IN skilled) AS without_skills, sumIf(cost_usd, session NOT IN skilled) AS cost_without_skills FROM (SELECT Attributes['session.id'] AS session, any(Attributes['vcs.repository.name']) AS repository, sum(Value) AS cost_usd FROM otel.otel_metrics_sum WHERE MetricName = 'agy.cost.usage' AND $__timeFilter(TimeUnix) GROUP BY session) GROUP BY repository ORDER BY without_skills DESC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "cost_without_skills"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          }
        ]
      },
      "options": {},
      "description": "Sessions where no skill ran, by repository."
    },
    {
      "id": 14,
      "type": "row",
      "title": "Tools and permissions",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 15,
      "type": "table",
      "title": "Tools",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT if(LogAttributes['mcp_tool_name'] != '', concat(LogAttributes['mcp_server_name'], ' / ', LogAttributes['mcp_tool_name']), LogAttributes['tool_name']) AS tool, count() AS calls, quantile(0.5)(toFloat64OrZero(LogAttributes['duration_ms'])) AS p50_ms, quantile(0.95)(toFloat64OrZero(LogAttributes['duration_ms'])) AS p95_ms, sum(toFloat64OrZero(LogAttributes['duration_ms'])) / 1000 AS total_time FROM otel.otel_logs WHERE LogAttributes['event.name'] = 'agy.tool_result' AND $__timeFilter(Timestamp) GROUP BY tool ORDER BY calls DESC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*_ms"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "total_time"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "options": {},
      "description": "MCP tools show as server / tool."
    },
    {
      "id": 16,
      "type": "table",
      "title": "Permission decisions",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT LogAttributes['tool_name'] AS tool, LogAttributes['scope'] AS scope, LogAttributes['source'] AS source, countIf(LogAttributes['decision'] = 'accept') AS accepted, countIf(LogAttributes['decision'] = 'reject') AS rejected, countIf(LogAttributes['decision'] = 'unanswered') AS unanswered FROM otel.otel_logs WHERE LogAttributes['event.name'] = 'agy.tool_decision' AND $__timeFilter(Timestamp) GROUP BY tool, scope, source ORDER BY count() DESC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "description": "source config: an allow or protection rule decided. user_prompt / user: you were asked. unanswered: the prompt was still waiting when the session went idle."
    },
    {
      "id": 17,
      "type": "row",
      "title": "MCP servers and subagents",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 41,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 18,
      "type": "table",
      "title": "MCP servers",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 42,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT if(LogAttributes['mcp_server_name'] = '', '(not recorded)', LogAttributes['mcp_server_name']) AS server, count() AS calls, uniqExact(LogAttributes['mcp_tool_name']) AS tools, quantile(0.95)(toFloat64OrZero(LogAttributes['duration_ms'])) AS p95_ms, max(Timestamp) AS last_used FROM otel.otel_logs WHERE LogAttributes['event.name'] = 'agy.tool_result' AND $__timeFilter(Timestamp) AND LogAttributes['tool_name'] = 'mcp_tool' GROUP BY server ORDER BY calls DESC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*_ms"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {}
    },
    {
      "id": 19,
      "type": "table",
      "title": "Subagents",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 12,
        "y": 42,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT LogAttributes['agent.type'] AS agent_type, LogAttributes['agent.role'] AS role, LogAttributes['model'] AS model, count() AS runs, countIf(LogAttributes['success'] = 'false') AS failures, max(Timestamp) AS last_used FROM otel.otel_logs WHERE LogAttributes['event.name'] = 'agy.subagent_invoked' AND $__timeFilter(Timestamp) GROUP BY agent_type, role, model ORDER BY runs DESC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "description": "Subagents launched via invoke_subagent."
    }
  ]
}
