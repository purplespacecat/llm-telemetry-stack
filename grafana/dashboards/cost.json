          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "WITH LogAttributes['event.name'] AS ev, ev = 'subagent_completed' AS done SELECT if(done, LogAttributes['agent_type'], LogAttributes['agent.name']) AS agent, if(done, LogAttributes['final_model'], LogAttributes['model']) AS model, countIf(done) AS runs, avgIfOrNull(toUInt64OrZero(LogAttributes['duration_ms']), done) AS avg_duration, sumIf(toUInt64OrZero(LogAttributes['total_tokens']), done) AS tokens, sumIf(toUInt64OrZero(LogAttributes['total_tool_uses']), done) AS tool_uses, sumIf(toFloat64OrZero(LogAttributes['cost_usd']), NOT done) AS cost_usd FROM otel.otel_logs WHERE (done OR (ev = 'api_request' AND startsWith(LogAttributes['query_source'], 'agent:'))) AND $__timeFilter(Timestamp) GROUP BY agent, model ORDER BY cost_usd DESC LIMIT 50",
          "refId": "A"
        }
