    {
      "id": 6,
      "type": "stat",
      "title": "Permission prompts",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT count() AS prompts FROM otel.otel_logs WHERE LogAttributes['event.name'] = 'agy.tool_decision' AND $__timeFilter(Timestamp) AND startsWith(LogAttributes['source'], 'user')",
