{
  "uid": "claude-code-reliability",
  "title": "Claude Code reliability",
  "description": "Failed API calls, tool calls, MCP connections and hooks.",
  "tags": [
    "claude-code",
    "llm"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "1m",
  "schemaVersion": 41,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "claude-code"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false,
      "title": "",
      "icon": "external link"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "API errors",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT count() AS errors FROM otel.otel_logs WHERE LogAttributes['event.name'] = 'api_error' AND $__timeFilter(Timestamp)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "colorMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "API error rate",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT countIf(LogAttributes['event.name'] = 'api_error') / nullIf(count(), 0) AS error_rate FROM otel.otel_logs WHERE LogAttributes['event.name'] IN ('api_error', 'api_request') AND $__timeFilter(Timestamp)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "colorMode": "none",
        "textMode": "value_and_name"
      },
      "description": "Failed API attempts as a share of all attempts, retries included."
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Retries exhausted",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT count() AS requests FROM otel.otel_logs WHERE LogAttributes['event.name'] = 'api_retries_exhausted' AND $__timeFilter(Timestamp)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "colorMode": "none",
        "textMode": "value_and_name"
      },
      "description": "Requests that still failed after Claude Code's automatic retries."
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Tool failure rate",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT countIf(LogAttributes['success'] = 'false') / nullIf(count(), 0) AS failure_rate FROM otel.otel_logs WHERE LogAttributes['event.name'] = 'tool_result' AND $__timeFilter(Timestamp)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "colorMode": "none",
        "textMode": "value_and_name"
      },
      "description": "Includes Bash commands that exit non-zero, such as a grep with no match."
    },
    {
      "id": 5,
      "type": "stat",
      "title": "MCP connection failures",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT countIf(LogAttributes['status'] = 'failed') AS failures FROM otel.otel_logs WHERE LogAttributes['event.name'] = 'mcp_server_connection' AND $__timeFilter(Timestamp)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "colorMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Hook errors",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT sum(toUInt32OrZero(LogAttributes['num_non_blocking_error'])) + sum(toUInt32OrZero(LogAttributes['num_cancelled'])) AS errors FROM otel.otel_logs WHERE LogAttributes['event.name'] = 'hook_execution_complete' AND $__timeFilter(Timestamp)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "colorMode": "none",
        "textMode": "value_and_name"
      },
      "description": "Hooks that failed or were cancelled."
    },
    {
      "id": 7,
      "type": "row",
      "title": "API",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "API errors by status",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(Timestamp) AS time, LogAttributes['status_code'] AS status, count() AS errors FROM otel.otel_logs WHERE LogAttributes['event.name'] = 'api_error' AND $__timeFilter(Timestamp) GROUP BY time, status ORDER BY time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "1h",
      "maxDataPoints": 60
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "API latency",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(Timestamp) AS time, quantile(0.5)(toFloat64OrZero(LogAttributes['duration_ms'])) AS p50, quantile(0.95)(toFloat64OrZero(LogAttributes['duration_ms'])) AS p95, quantile(0.5)(toFloat64OrZero(LogAttributes['ttft_ms'])) AS ttft_p50 FROM otel.otel_logs WHERE LogAttributes['event.name'] = 'api_request' AND $__timeFilter(Timestamp) GROUP BY time ORDER BY time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "ttft: time to the first token of the response."
    },
    {
      "id": 10,
      "type": "table",
      "title": "Failed API calls",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT Timestamp AS time, LogAttributes['model'] AS model, LogAttributes['status_code'] AS status, LogAttributes['error'] AS error, LogAttributes['attempt'] AS attempt, toFloat64OrZero(LogAttributes['duration_ms']) AS duration_ms, LogAttributes['query_source'] AS source FROM otel.otel_logs WHERE LogAttributes['event.name'] = 'api_error' AND $__timeFilter(Timestamp) ORDER BY Timestamp DESC LIMIT 100",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*_ms"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {}
    },
    {
      "id": 11,
      "type": "row",
      "title": "Tools",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 12,
      "type": "table",
      "title": "Tool failures",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT if(LogAttributes['mcp_tool_name'] != '', concat(LogAttributes['mcp_server_name'], ' / ', LogAttributes['mcp_tool_name']), LogAttributes['tool_name']) AS tool, count() AS calls, countIf(LogAttributes['success'] = 'false') AS failures, failures / calls AS failure_rate, maxIf(Timestamp, LogAttributes['success'] = 'false') AS last_failure FROM otel.otel_logs WHERE LogAttributes['event.name'] = 'tool_result' AND $__timeFilter(Timestamp) GROUP BY tool HAVING failures > 0 ORDER BY failures DESC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*_rate"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          }
        ]
      },
      "options": {},
      "description": "Tools with at least one failure. MCP tools show as server / tool."
    },
    {
      "id": 13,
      "type": "table",
      "title": "Failures by error type",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT if(LogAttributes['mcp_tool_name'] != '', concat(LogAttributes['mcp_server_name'], ' / ', LogAttributes['mcp_tool_name']), LogAttributes['tool_name']) AS tool, LogAttributes['error_type'] AS error_type, count() AS failures, max(Timestamp) AS last_seen FROM otel.otel_logs WHERE LogAttributes['event.name'] = 'tool_result' AND $__timeFilter(Timestamp) AND LogAttributes['success'] = 'false' GROUP BY tool, error_type ORDER BY failures DESC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "description": "Error messages aren't stored; the collector drops them with the tool arguments."
    },
    {
      "id": 14,
      "type": "row",
      "title": "MCP servers and hooks",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 15,
      "type": "table",
      "title": "MCP connections",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT if(LogAttributes['server_name'] = '', '(not recorded)', LogAttributes['server_name']) AS server, any(LogAttributes['transport_type']) AS transport, countIf(LogAttributes['status'] = 'connected') AS connected, countIf(LogAttributes['status'] = 'failed') AS failed, quantileIf(0.95)(toFloat64OrZero(LogAttributes['duration_ms']), LogAttributes['status'] != 'disconnected') AS connect_p95_ms, argMaxIf(if(LogAttributes['error'] != '', LogAttributes['error'], LogAttributes['error_code']), Timestamp, LogAttributes['status'] = 'failed') AS last_error FROM otel.otel_logs WHERE LogAttributes['event.name'] = 'mcp_server_connection' AND $__timeFilter(Timestamp) GROUP BY server ORDER BY failed DESC, connected DESC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*_ms"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {}
    },
    {
      "id": 16,
      "type": "table",
      "title": "Hook errors",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT LogAttributes['hook_name'] AS hook, count() AS runs, sum(toUInt32OrZero(LogAttributes['num_non_blocking_error'])) AS errors, sum(toUInt32OrZero(LogAttributes['num_cancelled'])) AS cancelled, (errors + cancelled) / runs AS error_rate, maxIf(Timestamp, toUInt32OrZero(LogAttributes['num_non_blocking_error']) + toUInt32OrZero(LogAttributes['num_cancelled']) > 0) AS last_error FROM otel.otel_logs WHERE LogAttributes['event.name'] = 'hook_execution_complete' AND $__timeFilter(Timestamp) GROUP BY hook HAVING errors + cancelled > 0 ORDER BY errors + cancelled DESC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*_rate"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          }
        ]
      },
      "options": {},
      "description": "Hooks that failed or were cancelled at least once."
    }
  ]
}
